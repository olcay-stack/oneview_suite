# AI Sovereignty Scan — copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production

# SMTP (e.g. your mail provider, or Ethereal/Mailpit for testing)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=scan@oneviewlogic.com
SMTP_PASS=change-me
MAIL_FROM="Oneview Logic AI Sovereignty Scan <scan@oneviewlogic.com>"
MAIL_TO=info@oneviewlogic.com
# Visitors get no copy by default (they contact info@ for details); set true to email them a copy too
SEND_COPY_TO_CLIENT=false

# Optional
# Max report submissions per IP per 15 minutes
RATE_LIMIT_MAX=5
# Set to 1 when running behind one reverse proxy (nginx, Caddy, PaaS router)
TRUST_PROXY=1
# Path to a Chromium/Chrome binary if Playwright's bundled browser is not installed
# CHROMIUM_PATH=/usr/bin/chromium
# Optional: enables GET /api/health?verify=<token> to test the SMTP login
# DIAG_TOKEN=choose-a-long-random-string
